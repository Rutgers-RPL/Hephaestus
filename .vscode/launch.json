{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (ST-LINK V3)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/Hephaestus.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "device": "STM32F411RETx",
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/STM32F411.svd",
            "rtos": "FreeRTOS",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ]
        }
    ]
}